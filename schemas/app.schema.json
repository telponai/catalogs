{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "url",
    "category"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "icon": {
      "type": "string",
      "pattern": "^https://"
    },
    "source": {
      "type": "string",
      "pattern": "^https://"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "official": {
      "type": "boolean"
    },
    "thirdParty": {
      "type": "boolean"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  }
}
